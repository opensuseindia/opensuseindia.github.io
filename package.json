{
  "name": "opensuseindia",
  "private": true,
  "version": "1.0.0",
  "description": "Production-ready full-stack event website for openSUSE India – Bengaluru Connect 2027",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"server,client\" -c \"green,cyan\" \"node server/index.js\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build && cp dist/index.html dist/404.html",
    "deploy": "gh-pages -d dist",
    "deploy:build": "npm run build && gh-pages -d dist",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@react-three/drei": "^9.120.0",
    "@react-three/fiber": "^8.17.10",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.4.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^11.15.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.7",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.3"
  }
}
